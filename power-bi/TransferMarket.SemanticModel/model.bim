{
  "name": "TransferMarket",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-GB",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "Transfers",
        "columns": [
          {
            "name": "record_id",
            "dataType": "string",
            "sourceColumn": "record_id",
            "summarizeBy": "none"
          },
          {
            "name": "player_name",
            "dataType": "string",
            "sourceColumn": "player_name",
            "summarizeBy": "none"
          },
          {
            "name": "from_club",
            "dataType": "string",
            "sourceColumn": "from_club",
            "summarizeBy": "none"
          },
          {
            "name": "to_club",
            "dataType": "string",
            "sourceColumn": "to_club",
            "summarizeBy": "none"
          },
          {
            "name": "announcement_date",
            "dataType": "dateTime",
            "sourceColumn": "announcement_date",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy"
          },
          {
            "name": "transfer_type",
            "dataType": "string",
            "sourceColumn": "transfer_type",
            "summarizeBy": "none"
          },
          {
            "name": "fee_status",
            "dataType": "string",
            "sourceColumn": "fee_status",
            "summarizeBy": "none"
          },
          {
            "name": "quoted_fee_gbp",
            "dataType": "double",
            "sourceColumn": "quoted_fee_gbp",
            "summarizeBy": "none"
          },
          {
            "name": "quote_basis",
            "dataType": "string",
            "sourceColumn": "quote_basis",
            "summarizeBy": "none"
          },
          {
            "name": "from_league",
            "dataType": "string",
            "sourceColumn": "from_league",
            "summarizeBy": "none"
          },
          {
            "name": "to_league",
            "dataType": "string",
            "sourceColumn": "to_league",
            "summarizeBy": "none"
          },
          {
            "name": "position",
            "dataType": "string",
            "sourceColumn": "position",
            "summarizeBy": "none"
          },
          {
            "name": "source_url",
            "dataType": "string",
            "sourceColumn": "source_url",
            "summarizeBy": "none"
          },
          {
            "name": "has_reported_fee",
            "dataType": "int64",
            "sourceColumn": "has_reported_fee",
            "summarizeBy": "none"
          },
          {
            "name": "is_permanent_fee",
            "dataType": "int64",
            "sourceColumn": "is_permanent_fee",
            "summarizeBy": "none"
          },
          {
            "name": "announcement_month",
            "dataType": "string",
            "sourceColumn": "announcement_month",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Transfers",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Snapshot = Table.FromRecords(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate))),\n    Source = if ProjectRoot = \"\" then Snapshot else Table.SelectColumns(Table.PromoteHeaders(Csv.Document(File.Contents(ProjectRoot & \"/data/processed/summer_transfers.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]), {\"record_id\", \"player_name\", \"from_club\", \"to_club\", \"announcement_date\", \"transfer_type\", \"fee_status\", \"quoted_fee_gbp\", \"quote_basis\", \"from_league\", \"to_league\", \"position\", \"source_url\", \"has_reported_fee\", \"is_permanent_fee\", \"announcement_month\"}),\n    BlanksToNull = Table.ReplaceValue(Source, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Source)),\n    Typed = Table.TransformColumnTypes(BlanksToNull, {{\"record_id\", type text}, {\"player_name\", type text}, {\"from_club\", type text}, {\"to_club\", type text}, {\"announcement_date\", type date}, {\"transfer_type\", type text}, {\"fee_status\", type text}, {\"quoted_fee_gbp\", type number}, {\"quote_basis\", type text}, {\"from_league\", type text}, {\"to_league\", type text}, {\"position\", type text}, {\"source_url\", type text}, {\"has_reported_fee\", Int64.Type}, {\"is_permanent_fee\", Int64.Type}, {\"announcement_month\", type text}}, \"en-GB\")\nin\n    Typed"
            }
          }
        ],
        "measures": [
          {
            "name": "Transfer records",
            "expression": "COUNTROWS(Transfers)",
            "formatString": "#,0"
          },
          {
            "name": "Reported permanent fees GBP",
            "expression": "CALCULATE(SUM(Transfers[quoted_fee_gbp]), Transfers[is_permanent_fee] = 1)",
            "formatString": "£#,0"
          },
          {
            "name": "Reported fee coverage",
            "expression": "DIVIDE(SUM(Transfers[has_reported_fee]), [Transfer records])",
            "formatString": "0.0%"
          },
          {
            "name": "Unknown fee records",
            "expression": "CALCULATE(COUNTROWS(Transfers), ISBLANK(Transfers[quoted_fee_gbp]))",
            "formatString": "#,0"
          },
          {
            "name": "Permanent fee deals",
            "expression": "SUM(Transfers[is_permanent_fee])",
            "formatString": "#,0"
          }
        ]
      },
      {
        "name": "HistoricalSample",
        "columns": [
          {
            "name": "player_name",
            "dataType": "string",
            "sourceColumn": "player_name",
            "summarizeBy": "none"
          },
          {
            "name": "from_club_name",
            "dataType": "string",
            "sourceColumn": "from_club_name",
            "summarizeBy": "none"
          },
          {
            "name": "to_club_name",
            "dataType": "string",
            "sourceColumn": "to_club_name",
            "summarizeBy": "none"
          },
          {
            "name": "transfer_date",
            "dataType": "dateTime",
            "sourceColumn": "transfer_date",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy"
          },
          {
            "name": "transfer_fee",
            "dataType": "double",
            "sourceColumn": "transfer_fee",
            "summarizeBy": "none"
          },
          {
            "name": "mv_at_transfer",
            "dataType": "double",
            "sourceColumn": "mv_at_transfer",
            "summarizeBy": "none"
          },
          {
            "name": "fee_to_mv",
            "dataType": "double",
            "sourceColumn": "fee_to_mv",
            "summarizeBy": "none"
          },
          {
            "name": "position",
            "dataType": "string",
            "sourceColumn": "position",
            "summarizeBy": "none"
          },
          {
            "name": "age_at_transfer",
            "dataType": "int64",
            "sourceColumn": "age_at_transfer",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "HistoricalSample",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Snapshot = Table.FromRecords(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate))),\n    Source = if ProjectRoot = \"\" then Snapshot else Table.SelectColumns(Table.PromoteHeaders(Csv.Document(File.Contents(ProjectRoot & \"/data/processed/paid_sample.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]), {\"player_name\", \"from_club_name\", \"to_club_name\", \"transfer_date\", \"transfer_fee\", \"mv_at_transfer\", \"fee_to_mv\", \"position\", \"age_at_transfer\"}),\n    BlanksToNull = Table.ReplaceValue(Source, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Source)),\n    Typed = Table.TransformColumnTypes(BlanksToNull, {{\"player_name\", type text}, {\"from_club_name\", type text}, {\"to_club_name\", type text}, {\"transfer_date\", type date}, {\"transfer_fee\", type number}, {\"mv_at_transfer\", type number}, {\"fee_to_mv\", type number}, {\"position\", type text}, {\"age_at_transfer\", Int64.Type}}, \"en-GB\")\nin\n    Typed"
            }
          }
        ],
        "measures": [
          {
            "name": "Sample fees EUR",
            "expression": "SUM(HistoricalSample[transfer_fee])",
            "formatString": "€#,0"
          },
          {
            "name": "Sample median fee EUR",
            "expression": "MEDIAN(HistoricalSample[transfer_fee])",
            "formatString": "€#,0"
          },
          {
            "name": "Sample records",
            "expression": "COUNTROWS(HistoricalSample)",
            "formatString": "#,0"
          }
        ]
      },
      {
        "name": "ValuationSample",
        "columns": [
          {
            "name": "player_name",
            "dataType": "string",
            "sourceColumn": "player_name",
            "summarizeBy": "none"
          },
          {
            "name": "position",
            "dataType": "string",
            "sourceColumn": "position",
            "summarizeBy": "none"
          },
          {
            "name": "sub_position",
            "dataType": "string",
            "sourceColumn": "sub_position",
            "summarizeBy": "none"
          },
          {
            "name": "age",
            "dataType": "int64",
            "sourceColumn": "age",
            "summarizeBy": "none"
          },
          {
            "name": "current_club_name",
            "dataType": "string",
            "sourceColumn": "current_club_name",
            "summarizeBy": "none"
          },
          {
            "name": "league",
            "dataType": "string",
            "sourceColumn": "league",
            "summarizeBy": "none"
          },
          {
            "name": "tm_value",
            "dataType": "double",
            "sourceColumn": "tm_value",
            "summarizeBy": "none"
          },
          {
            "name": "fair_value",
            "dataType": "double",
            "sourceColumn": "fair_value",
            "summarizeBy": "none"
          },
          {
            "name": "tm_to_fair",
            "dataType": "double",
            "sourceColumn": "tm_to_fair",
            "summarizeBy": "none"
          },
          {
            "name": "minutes",
            "dataType": "int64",
            "sourceColumn": "minutes",
            "summarizeBy": "none"
          },
          {
            "name": "goals",
            "dataType": "int64",
            "sourceColumn": "goals",
            "summarizeBy": "none"
          },
          {
            "name": "assists",
            "dataType": "int64",
            "sourceColumn": "assists",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "ValuationSample",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Snapshot = Table.FromRecords(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate))),\n    Source = if ProjectRoot = \"\" then Snapshot else Table.SelectColumns(Table.PromoteHeaders(Csv.Document(File.Contents(ProjectRoot & \"/data/processed/valuation_sample.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]), {\"player_name\", \"position\", \"sub_position\", \"age\", \"current_club_name\", \"league\", \"tm_value\", \"fair_value\", \"tm_to_fair\", \"minutes\", \"goals\", \"assists\"}),\n    BlanksToNull = Table.ReplaceValue(Source, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Source)),\n    Typed = Table.TransformColumnTypes(BlanksToNull, {{\"player_name\", type text}, {\"position\", type text}, {\"sub_position\", type text}, {\"age\", Int64.Type}, {\"current_club_name\", type text}, {\"league\", type text}, {\"tm_value\", type number}, {\"fair_value\", type number}, {\"tm_to_fair\", type number}, {\"minutes\", Int64.Type}, {\"goals\", Int64.Type}, {\"assists\", Int64.Type}}, \"en-GB\")\nin\n    Typed"
            }
          }
        ],
        "measures": [
          {
            "name": "Valuation records",
            "expression": "COUNTROWS(ValuationSample)",
            "formatString": "#,0"
          },
          {
            "name": "Listed value EUR",
            "expression": "SUM(ValuationSample[tm_value])",
            "formatString": "€#,0"
          },
          {
            "name": "Model estimate EUR",
            "expression": "SUM(ValuationSample[fair_value])",
            "formatString": "€#,0"
          },
          {
            "name": "Model gap EUR",
            "expression": "[Model estimate EUR] - [Listed value EUR]",
            "formatString": "€#,0"
          }
        ]
      },
      {
        "name": "DestinationLeague",
        "columns": [
          {
            "name": "League",
            "dataType": "string",
            "sourceColumn": "League",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DestinationLeague",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let Source = #table(type table [League = type text], {{\"Bundesliga\"}, {\"La Liga\"}, {\"Ligue 1\"}, {\"Outside top five / unattached\"}, {\"Premier League\"}, {\"Serie A\"}}) in Source"
            }
          }
        ]
      },
      {
        "name": "AnnouncementDate",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "AnnouncementDate",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let Source = #table(type table [Date = type date], {{#date(2026,02,13)}, {#date(2026,03,16)}, {#date(2026,04,17)}, {#date(2026,04,22)}, {#date(2026,04,23)}, {#date(2026,04,30)}, {#date(2026,05,05)}, {#date(2026,05,08)}, {#date(2026,05,15)}, {#date(2026,05,20)}, {#date(2026,05,22)}, {#date(2026,05,23)}, {#date(2026,05,26)}, {#date(2026,05,27)}, {#date(2026,05,28)}, {#date(2026,05,29)}, {#date(2026,06,01)}, {#date(2026,06,02)}, {#date(2026,06,03)}, {#date(2026,06,04)}, {#date(2026,06,05)}, {#date(2026,06,06)}, {#date(2026,06,08)}, {#date(2026,06,09)}, {#date(2026,06,10)}, {#date(2026,06,11)}, {#date(2026,06,12)}, {#date(2026,06,13)}, {#date(2026,06,15)}, {#date(2026,06,16)}, {#date(2026,06,17)}, {#date(2026,06,18)}, {#date(2026,06,19)}, {#date(2026,06,20)}, {#date(2026,06,21)}, {#date(2026,06,22)}, {#date(2026,06,23)}, {#date(2026,06,24)}, {#date(2026,06,25)}, {#date(2026,06,26)}, {#date(2026,06,27)}, {#date(2026,06,29)}, {#date(2026,06,30)}, {#date(2026,07,01)}, {#date(2026,07,02)}, {#date(2026,07,03)}, {#date(2026,07,04)}, {#date(2026,07,05)}, {#date(2026,07,06)}, {#date(2026,07,07)}, {#date(2026,07,08)}, {#date(2026,07,09)}, {#date(2026,07,10)}, {#date(2026,07,11)}, {#date(2026,07,12)}, {#date(2026,07,13)}, {#date(2026,07,14)}, {#date(2026,07,15)}, {#date(2026,07,16)}, {#date(2026,07,17)}, {#date(2026,07,18)}, {#date(2026,07,19)}, {#date(2026,07,20)}, {#date(2026,07,21)}, {#date(2026,07,22)}, {#date(2026,07,23)}, {#date(2026,07,24)}, {#date(2026,07,25)}, {#date(2026,07,26)}, {#date(2026,07,27)}, {#date(2026,07,28)}, {#date(2026,07,29)}, {#date(2026,07,30)}, {#date(2026,07,31)}, {#date(2026,08,01)}, {#date(2026,08,02)}, {#date(2026,08,03)}, {#date(2026,08,04)}, {#date(2026,08,05)}, {#date(2026,08,06)}, {#date(2026,08,07)}, {#date(2026,08,08)}, {#date(2026,08,09)}, {#date(2026,08,10)}, {#date(2026,08,11)}, {#date(2026,08,12)}, {#date(2026,08,13)}, {#date(2026,08,14)}, {#date(2026,08,15)}, {#date(2026,08,16)}, {#date(2026,08,17)}, {#date(2026,08,18)}, {#date(2026,08,19)}, {#date(2026,08,20)}, {#date(2026,08,21)}, {#date(2026,08,22)}, {#date(2026,08,23)}, {#date(2026,08,24)}, {#date(2026,08,25)}, {#date(2026,08,26)}, {#date(2026,08,27)}, {#date(2026,08,28)}, {#date(2026,08,29)}, {#date(2026,08,30)}, {#date(2026,08,31)}, {#date(2026,09,01)}, {#date(2026,09,02)}, {#date(2026,09,03)}, {#date(2026,09,04)}, {#date(2026,09,07)}, {#date(2026,09,08)}, {#date(2026,09,09)}, {#date(2026,09,10)}, {#date(2026,09,11)}}) in Source"
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "destination_league",
        "fromTable": "Transfers",
        "fromColumn": "to_league",
        "toTable": "DestinationLeague",
        "toColumn": "League",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "announcement_date",
        "fromTable": "Transfers",
        "fromColumn": "announcement_date",
        "toTable": "AnnouncementDate",
        "toColumn": "Date",
        "crossFilteringBehavior": "oneDirection"
      }
    ],
    "expressions": [
      {
        "name": "ProjectRoot",
        "kind": "m",
        "expression": "\"\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=false]",
        "description": "Optional repository root, e.g. C:/Projects/football-transfer-market-analysis. Blank uses bundled snapshot."
      }
    ]
  }
}