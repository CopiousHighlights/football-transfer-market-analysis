let
    Snapshot = Table.FromRecords(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate))),
    Source = if ProjectRoot = "" then Snapshot else Table.SelectColumns(Table.PromoteHeaders(Csv.Document(File.Contents(ProjectRoot & "/data/processed/valuation_sample.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]), {"player_name", "position", "sub_position", "age", "current_club_name", "league", "tm_value", "fair_value", "tm_to_fair", "minutes", "goals", "assists"}),
    BlanksToNull = Table.ReplaceValue(Source, "", null, Replacer.ReplaceValue, Table.ColumnNames(Source)),
    Typed = Table.TransformColumnTypes(BlanksToNull, {{"player_name", type text}, {"position", type text}, {"sub_position", type text}, {"age", Int64.Type}, {"current_club_name", type text}, {"league", type text}, {"tm_value", type number}, {"fair_value", type number}, {"tm_to_fair", type number}, {"minutes", Int64.Type}, {"goals", Int64.Type}, {"assists", Int64.Type}}, "en-GB")
in
    Typed